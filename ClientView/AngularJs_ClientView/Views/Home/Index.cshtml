@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Modern Variables */
    :root {
        --primary-color: #03037B;
        --primary-light: #3a3ab3;
        --success-color: #28a745;
        --warning-color: #ffc107;
        --danger-color: #dc3545;
        --available-color: #4CAF50;
        --booked-color: #FF6B6B;
        --card-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        --card-hover-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
        --transition-speed: 0.3s;
    }

    /* Welcome Header */
    .welcome-header {
        background: linear-gradient(135deg, var(--primary-color) 0%, #1a1a8a 100%);
        color: white;
        padding: 1.2rem;
        border-radius: 15px;
        margin-bottom: 1rem;
        position: relative;
        overflow: hidden;
    }

        .welcome-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" preserveAspectRatio="none"><path d="M0,0 L100,0 L100,100 Z" fill="rgba(255,255,255,0.1)"/></svg>');
            background-size: cover;
        }

        .welcome-header h1 {
            font-size: 2.5rem;
            font-weight: 700;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
            margin-bottom: 0.5rem;
        }

        .welcome-header .user-greeting {
            font-size: 1.2rem;
            opacity: 0.9;
            display: flex;
            align-items: center;
            gap: 10px;
        }

    .user-icon {
        width: 30px;
        height: 30px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    /* Table Cards */
    .table-card {
        border: none;
        border-radius: 20px;
        overflow: hidden;
        transition: all var(--transition-speed) ease;
        cursor: pointer;
        height: 100%;
        background: white;
        position: relative;
        min-height: 220px;
    }

        .table-card:hover {
            transform: translateY(-10px);
            box-shadow: var(--card-hover-shadow);
        }

        .table-card.disabled {
            opacity: 0.7;
            cursor: not-allowed;
            filter: grayscale(30%);
        }

            .table-card.disabled:hover {
                transform: none;
                box-shadow: var(--card-shadow);
            }

    .table-card-header {
        background: linear-gradient(135deg, var(--primary-color), var(--primary-light));
        color: white;
        padding: 1.2rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
    }

    .table-number {
        font-size: 2.2rem;
        font-weight: 800;
        letter-spacing: 1px;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
    }

    .table-status-indicator {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.2);
        position: relative;
    }

        .table-status-indicator.available {
            background: rgba(76, 175, 80, 0.2);
            border: 3px solid var(--available-color);
        }

        .table-status-indicator.booked {
            background: rgba(255, 107, 107, 0.2);
            border: 3px solid var(--booked-color);
        }

        .table-status-indicator i {
            font-size: 1.5rem;
            color: white;
        }

    .table-card-body {
        padding: 1.5rem;
        text-align: center;
        background: #f8f9fa;
    }

    .table-name {
        font-size: 1.3rem;
        font-weight: 600;
        color: #333;
        margin-bottom: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .table-status {
        display: inline-block;
        padding: 8px 25px;
        border-radius: 50px;
        font-weight: 600;
        font-size: 1.1rem;
        letter-spacing: 1px;
        margin: 10px 0;
    }

        .table-status.available {
            background: linear-gradient(135deg, var(--available-color), #5cd85c);
            color: white;
            box-shadow: 0 4px 15px rgba(76, 175, 80, 0.3);
        }

        .table-status.booked {
            background: linear-gradient(135deg, var(--booked-color), #ff8a8a);
            color: white;
            box-shadow: 0 4px 15px rgba(255, 107, 107, 0.3);
        }

    .table-capacity {
        margin-top: 1rem;
        color: #666;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .table-capacity i {
            color: var(--primary-color);
        }

    /* Loading Animation */
    .table-loading {
        animation: pulse 1.5s infinite;
    }

    /* Grid Layout */
    .tables-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 25px;
        padding: 20px 0;
    }

    /* Empty State */
    .empty-state {
        grid-column: 1 / -1;
        text-align: center;
        padding: 60px 20px;
    }

        .empty-state i {
            font-size: 4rem;
            color: #ddd;
            margin-bottom: 20px;
        }

        .empty-state h3 {
            color: #666;
            font-weight: 600;
        }
</style>

<div id="content" ng-controller="homeController">
    <div class="right_col" role="main">
        <div class="">
            <!-- Enhanced Welcome Header -->
            <div class="welcome-header">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h1><i class="fas fa-utensils me-3"></i>&nbsp;&nbsp; Welcome to Smart Restaurant</h1>
                    </div>
                    <div class="col-md-4 text-md-end">
                        <div class="stats-card">
                            <div class="d-flex justify-content-center justify-content-md-end">
                                <div class="me-4" style="margin-right: 15px; text-align: center;">
                                    <h3 class="mb-0">{{allTableJsonListData.length}}</h3>
                                    <small>Total Tables</small>
                                </div>
                                <div style="text-align: center;">
                                    <h3 class="mb-0">{{getAvailableTables()}}</h3>
                                    <small>Available Now</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tables Grid -->
            <div class="tables-grid">
                <!-- Loading State -->
                <div ng-if="!allTableJsonListData || allTableJsonListData.length === 0" class="empty-state">
                    <i class="fas fa-chair"></i>
                    <h3>Loading tables...</h3>
                    <p>Please wait while we fetch the table information</p>
                </div>

                <!-- Table Cards -->
                <div ng-repeat="item in allTableJsonListData"
                     class="table-card"
                     ng-class="{'disabled': item.IsAvailableTbl === false}"
                     ng-click="item.IsAvailableTbl !== false && clickToOpenOrder(item.TableId, item.Table)">

                    <div class="table-card-header">
                        <div class="table-number">#{{$index + 1}}</div>
                        <div class="table-status-indicator"
                             ng-class="item.IsAvailableTbl ? 'available' : 'booked'">
                            <i ng-class="item.IsAvailableTbl ? 'fas fa-check' : 'fas fa-clock'"></i>
                        </div>
                    </div>

                    <div class="table-card-body">
                        <div class="table-name">{{item.Table}}</div>

                        <div class="table-status"
                             ng-class="item.IsAvailableTbl ? 'available' : 'booked'">
                            {{item.IsAvailableTbl ? 'AVAILABLE' : 'OCCUPIED'}}
                        </div>

                        <div class="table-capacity">
                            <i class="fas fa-users"></i>
                            <span>Capacity: {{item.Capacity || '4'}} persons</span>
                        </div>

                        <div class="mt-3">
                            <small class="text-muted">
                                <i class="fas fa-door-open me-1"></i>
                                Click to {{item.IsAvailableTbl ? 'Open Order' : 'View Details'}}
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/ngServices/FoodItemService/foodItemService.js?reload=@DateTime.Now.Date.ToShortDateString()"></script>
    @*<script src="~/Scripts/ngServices/FoodOrderService/foodOrderService.js?reload=@DateTime.Now.Date.ToShortDateString()"></script>*@
    <script src="~/Scripts/ngControllers/Home/homeController.js?reload=@DateTime.Now.Date.ToShortDateString()"></script>
    <script src="~/Scripts/ngServices/jwtHelper.js?reload=@DateTime.Now.Date.ToShortDateString()"></script>
}