@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en" ng-app="myApp">
<head>
    <meta charset="utf-8" />
    <base href="/">
    <title>Smart Restaurant - Login</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="~/Content/css/customLoginPage.css" rel="stylesheet" />
</head>
<body>
    <div class="food-bg">
        <div class="pot">
            <div class="noodles">
                <div class="noodle-swirl"></div>
                <div class="noodle-swirl noodle-swirl2"></div>
                <div class="noodle-swirl noodle-swirl3"></div>
            </div>
            <div class="bubbles">
                <div class="bubble b1"></div>
                <div class="bubble b2"></div>
                <div class="bubble b3"></div>
                <div class="bubble b4"></div>
                <div class="bubble b5"></div>
            </div>
        </div>

        <div class="steam">
            <div class="steam-particle particle1"></div>
            <div class="steam-particle particle2"></div>
            <div class="steam-particle particle3"></div>
            <div class="steam-particle particle4"></div>
            <div class="steam-particle particle5"></div>
            <div class="steam-particle particle6"></div>
        </div>
        <div class="steam-wisp"></div>
        <div class="steam-wisp steam-wisp2"></div>

        <!-- extra floating gradients -->
        <div></div>
        <div></div>
    </div>

    <!-- login card with modern design & animations (exactly matching register) -->
    <div class="login-wrapper" ng-controller="loginController">
        <div class="login-card animate__animated animate__zoomIn">
            <div class="text-center mb-4">
                <div class="mb-2">
                    <i class="fas fa-utensils fa-3x" style="color: #b86a32;"></i>
                </div>
                <h3 class="fw-bold" style="color: #35281a; letter-spacing: -0.5px;">Welcome Back</h3>
                <p class="text-muted" style="color: #5a4230 !important;">sign in to continue</p>
            </div>

            <form name="frmLogin" novalidate ng-submit="login()">
                <!-- username field -->
                <div class="input-group mb-1">
                    <span class="input-group-text"><i class="fas fa-user"></i></span>
                    <input type="text" name="username" class="form-control" placeholder="Username"
                           ng-model="username" required>
                </div>
                <span class="error-text" ng-show="frmLogin.username.$touched && frmLogin.username.$invalid">username is required</span>

                <!-- password field -->
                <div class="input-group mb-1">
                    <span class="input-group-text"><i class="fas fa-lock"></i></span>
                    <input type="password" name="password" class="form-control" placeholder="Password"
                           ng-model="password" required>
                </div>
                <span class="error-text" ng-show="frmLogin.password.$touched && frmLogin.password.$invalid">password required</span>

                <!-- login button -->
                <button type="submit" class="btn btn-login w-100 mt-4"
                        ng-disabled="frmLogin.$invalid">
                    <i class="fas fa-sign-in-alt me-2"></i> Sign In
                </button>

                <!-- register link -->
                <div class="text-center mt-4">
                    <a href="javascript:void(0)" class="text-decoration-none" ng-click="openRegisterPage()" style="color: #4f351f; font-weight: 500;">
                        New here? <span style="color: #b45d2a; font-weight: 600; border-bottom: 1px dashed #b45d2a;">Create an Account</span>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <script src="~/Scripts/angular.min.js"></script>
    <script src="~/Scripts/angular-route.min.js"></script>
    <script src="~/Scripts/ng-file-upload.min.js"></script>
    <script src="~/Scripts/myApp.js?reload=@DateTime.Now.Date.ToShortDateString()"></script>

    <script src="~/Scripts/ngServices/authInterceptor.js?reload=@DateTime.Now.Date.ToShortDateString()"></script>
    <script src="~/Scripts/ngServices/Authentication/authService.js?reload=@DateTime.Now.Date.ToShortDateString()"></script>
    <script src="~/Scripts/ngControllers/Login/loginController.js?reload=@DateTime.Now.Date.ToShortDateString()"></script>
    <script src="~/Scripts/sweetAlert.js"></script>
</body>
</html>
