@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en" ng-app="myApp">
<head>
    <meta charset="utf-8" />
    <base href="/">
    <title>Smart Restaurant - Register</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="~/Content/css/customRegistrationPage.css" rel="stylesheet" />
</head>
<body>
    <div class="food-bg">
        <div class="pot">
            <div class="noodles">
                <div class="noodle-swirl"></div>
                <div class="noodle-swirl noodle-swirl2"></div>
                <div class="noodle-swirl noodle-swirl3"></div>
            </div>
            <div class="bubbles">
                <div class="bubble b1"></div>
                <div class="bubble b2"></div>
                <div class="bubble b3"></div>
                <div class="bubble b4"></div>
                <div class="bubble b5"></div>
            </div>
        </div>

        <div class="steam">
            <div class="steam-particle particle1"></div>
            <div class="steam-particle particle2"></div>
            <div class="steam-particle particle3"></div>
            <div class="steam-particle particle4"></div>
            <div class="steam-particle particle5"></div>
            <div class="steam-particle particle6"></div>
        </div>
        <div class="steam-wisp"></div>
        <div class="steam-wisp steam-wisp2"></div>

        <!-- extra floating gradients for depth -->
        <div style="position: absolute; bottom: 250px; left: 30%; width: 320px; height: 220px; background: rgba(255,220,160,0.12); filter: blur(45px); border-radius: 50%; animation: pulseGlow 12s infinite alternate;"></div>
        <div style="position: absolute; bottom: 280px; left: 60%; width: 380px; height: 270px; background: rgba(235,200,150,0.08); filter: blur(55px); border-radius: 50%; animation: pulseGlow2 14s infinite alternate;"></div>
    </div>

    <!-- registration card with modern design + extra animations -->
    <div class="register-wrapper" ng-controller="registerController">
        <div class="register-card animate__animated animate__fadeInDown">
            <div class="text-center mb-4">
                <div class="mb-2">
                    <i class="fas fa-user-plus fa-3x" style="color: #b86a32;"></i>
                </div>
                <h3 class="fw-bold" style="color: #35281a; letter-spacing: -0.5px;">Create Account</h3>
                <p class="text-muted" style="color: #5a4230 !important;">join the flavor experience</p>
            </div>

            <form name="frmRegister" novalidate ng-submit="registerUser()">
                <!-- full name -->
                <div class="input-group mb-1">
                    <span class="input-group-text"><i class="fas fa-user"></i></span>
                    <input type="text" name="fullname" class="form-control" placeholder="Full name"
                           ng-model="fullname" required>
                </div>
                <span class="error-msg" ng-show="frmRegister.fullname.$touched && frmRegister.fullname.$invalid">full name is required</span>

                <!-- username -->
                <div class="input-group mb-1">
                    <span class="input-group-text"><i class="fas fa-at"></i></span>
                    <input type="text" name="userName" class="form-control" placeholder="Username"
                           ng-model="userName" required ng-minlength="4">
                </div>
                <span class="error-msg" ng-show="frmRegister.userName.$touched && frmRegister.userName.$invalid">minimum 4 characters</span>

                <!-- password -->
                <div class="input-group mb-1">
                    <span class="input-group-text"><i class="fas fa-lock"></i></span>
                    <input type="password" name="password" class="form-control" placeholder="Password"
                           ng-model="password" required>
                </div>
                <span class="error-msg" ng-show="frmRegister.password.$touched && frmRegister.password.$invalid">password required</span>

                <!-- confirm password -->
                <div class="input-group mb-1">
                    <span class="input-group-text"><i class="fas fa-check-double"></i></span>
                    <input type="password" name="confirmPassword" class="form-control" placeholder="Confirm password"
                           ng-model="confirmPassword" required>
                </div>
                <span class="error-msg" ng-show="confirmPassword !== password && frmRegister.confirmPassword.$touched">passwords must match</span>

                <button type="submit" class="btn btn-register w-100 mt-4"
                        ng-disabled="frmRegister.$invalid || confirmPassword !== password">
                    <i class="fas fa-user-plus me-2"></i> Register Now
                </button>

                <div class="text-center mt-4">
                    <a href="javascript:void(0)" class="text-decoration-none" ng-click="openLoginForm()" style="color: #4f351f; font-weight: 500;">
                        Already have an account? <span style="color: #b45d2a; font-weight: 600; border-bottom: 1px dashed #b45d2a;">Login</span>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <script src="~/Scripts/angular.min.js"></script>
    <script src="~/Scripts/angular-route.min.js"></script>
    <script src="~/Scripts/ng-file-upload.min.js"></script>
    <script src="~/Scripts/myApp.js?reload=@DateTime.Now.Date.ToShortDateString()"></script>

    <script src="~/Scripts/ngServices/authInterceptor.js?reload=@DateTime.Now.Date.ToShortDateString()"></script>
    <script src="~/Scripts/ngServices/Authentication/authService.js?reload=@DateTime.Now.Date.ToShortDateString()"></script>
    <script src="~/Scripts/ngControllers/Registration/registerController.js?reload=@DateTime.Now.Date.ToShortDateString()"></script>
    <script src="~/Scripts/sweetAlert.js"></script>

</body>
</html>