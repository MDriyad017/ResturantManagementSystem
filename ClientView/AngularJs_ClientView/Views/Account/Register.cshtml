@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en" ng-app="myApp">
<head>
    <meta charset="utf-8" />
    <base href="/">
    <title>Smart Restaurant - Register</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .register-card {
            max-width: 450px;
            margin-top: 60px;
            background: rgba(255, 255, 255, 0.95);
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.2);
        }

        .input-group-text {
            background: transparent;
            border-right: none;
        }

        .form-control {
            border-left: none;
        }

            .form-control:focus {
                box-shadow: none;
                border-color: #ced4da;
            }

        .error-msg {
            color: #e74c3c;
            font-size: 0.85rem;
            margin-bottom: 10px;
            display: block;
        }

        .btn-register {
            background: #764ba2;
            border: none;
            padding: 12px;
            transition: 0.3s;
        }

            .btn-register:hover {
                background: #667eea;
                transform: translateY(-2px);
            }
    </style>
</head>
<body>
    <div class="container" ng-controller="registerController">
        <div class="register-card mx-auto animate__animated animate__fadeInDown">
            <div class="text-center mb-4">
                <div class="mb-2">
                    <i class="fas fa-user-plus fa-3x" style="color: #464040; "></i>
                </div>
                <h3 class="fw-bold" style="color: #464040;">Create Account</h3>
                <p class="text-muted">Join our Smart Restaurant team</p>
            </div>

            <form name="frmRegister" novalidate ng-submit="registerUser()">
                <div class="input-group mb-1">
                    <span class="input-group-text"><i class="fas fa-user"></i></span>
                    <input type="text" name="fullname" class="form-control" placeholder="Full Name"
                           ng-model="fullname" required>
                </div>
                <span class="error-msg" ng-show="frmRegister.fullname.$touched && frmRegister.fullname.$invalid">Full name is required</span>

                <div class="input-group mb-1">
                    <span class="input-group-text"><i class="fas fa-at"></i></span>
                    <input type="text" name="userName" class="form-control" placeholder="Username"
                           ng-model="userName" required ng-minlength="4">
                </div>
                <span class="error-msg" ng-show="frmRegister.userName.$touched && frmRegister.userName.$invalid">Username must be at least 4 characters</span>

                <div class="input-group mb-1">
                    <span class="input-group-text"><i class="fas fa-lock"></i></span>
                    <input type="password" name="password" class="form-control" placeholder="Password"
                           ng-model="password" required>
                </div>
                <span class="error-msg" ng-show="frmRegister.password.$touched && frmRegister.password.$invalid">Password is required</span>

                <div class="input-group mb-1">
                    <span class="input-group-text"><i class="fas fa-check-double"></i></span>
                    <input type="password" name="confirmPassword" class="form-control" placeholder="Confirm Password"
                           ng-model="confirmPassword" required>
                </div>
                <span class="error-msg" ng-show="confirmPassword !== password && frmRegister.confirmPassword.$touched">Passwords do not match</span>

                <button type="submit" class="btn btn-danger w-100 btn-register mt-3"
                        ng-disabled="frmRegister.$invalid || confirmPassword !== password">
                    <i class="fas fa-user-plus me-2"></i> Register Now
                </button>

                <div class="text-center mt-4">
                    <a href="javascript:void(0)" class="text-decoration-none" ng-click="openLoginForm()">
                        Already have an account? <span style="color: #764ba2; font-weight: 600;">Login</span>
                    </a>
                </div>
            </form>
        </div>
    </div>

    @*<script src="~/Scripts/angular.min.js"></script>
        <script src="~/Scripts/myApp.js?reload=@DateTime.Now.Date.ToShortDateString()"></script>

        <script src="~/Scripts/ngControllers/Registration/registerController.js?reload=@DateTime.Now.Date.ToShortDateString()"></script>
        <script src="~/Scripts/ngServices/Authentication/authService.js?reload=@DateTime.Now.Date.ToShortDateString()"></script>*@

    <script src="~/Scripts/angular.min.js"></script>
    <script src="~/Scripts/angular-route.min.js"></script>
    <script src="~/Scripts/ng-file-upload.min.js"></script>
    <script src="~/Scripts/myApp.js?reload=@DateTime.Now.Date.ToShortDateString()"></script>

    <script src="~/Scripts/ngServices/authInterceptor.js?reload=@DateTime.Now.Date.ToShortDateString()"></script>
    <script src="~/Scripts/ngServices/Authentication/authService.js?reload=@DateTime.Now.Date.ToShortDateString()"></script>
    <script src="~/Scripts/ngControllers/Registration/registerController.js?reload=@DateTime.Now.Date.ToShortDateString()"></script>
    <script src="~/Scripts/sweetAlert.js"></script>

</body>
</html>


