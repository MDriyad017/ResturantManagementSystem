@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/css/menuResponsive.css" rel="stylesheet" />
<link href="~/Content/css/forProductOrderResposive.css" rel="stylesheet" />

<style>
    .disabled-div {
        opacity: 0.4;
    }

        .disabled-div:hover {
            cursor: not-allowed;
        }
</style>

<div id="content" ng-controller="foodOrderController" class="container-fluid bg-light">
    <div class="row">
        <div class="col-lg-2 p-0">
            <div class="sidebar-menu">
                <h4 class="text-center mb-4 d-none d-lg-block">&nbsp;</h4>
                <h4 class="text-center mb-4 d-none d-lg-block">&nbsp;</h4>
                <ul class="menu-list">
                    <!-- All categories including "All Dishes" are now dynamic -->
                    <li class="menu-item" ng-repeat="category in foodCategoryListDropDownJsonData" ng-class="{'active': selectedCat == category.Value}">
                        <a href="" ng-click="filterFoodsCategoryWise(category.Value)">
                            <i class="fa" ng-class="category.Value == 'ALL' ? 'fa-utensils' : 'fa-layer-group'"></i>&nbsp;&nbsp;
                            <span class="menu-text">{{category.Item}}</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="col-lg-7 p-4" style="padding: 1rem !important;">
            <div class="d-flex justify-content-end align-items-center mb-4">
                <span class="text-muted" style="font-size: 25px;"><strong>{{tableName}}</strong></span>
            </div>

            <div class="row" style="max-height: 80vh; overflow: auto;">
                <div class="col-md-4 mb-4" ng-repeat="item in allFoodsJsonListData">
                    <div class="food-card" ng-class="{'disabled-div': item.Stock === 0}">
                        <div class="img-container text-center">
                            <span class="stock-badge" ng-class="{'out-of-stock': item.Stock === 0}">
                                {{item.Stock === 0 ? 'Sold Out' : item.Stock + ' Left'}}
                            </span>
                            <img src="~/Images/FoodImg/{{item.FoodId}}.jpg" class="food-img" alt="{{item.FoodName}}">
                        </div>
                        <div class="p-3 text-center">
                            <h5 class="mb-1 fw-bold">{{item.FoodName}}</h5>
                            <div class="price-tag mb-3"><span style="font-size: 28px;">৳</span>&nbsp;{{item.FoodPrice.toFixed(2)}}</div>
                            <button class="btn btn-primary w-100 add-btn" ng-click="clickToAddFoods(item)" ng-disabled="item.Stock === 0">
                                <i class="fa fa-plus me-2"></i> Add to Order
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3 p-4" style="height: 80vh !important;">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden" style="margin-top: 10px;">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="fw-bold mb-0"><i class="fa fa-shopping-basket me-2"></i>My Order</h5>
                </div>
                <div class="card-body p-0" style="max-height: 400px; overflow-y: auto;">
                    <div ng-if="selectedFoodForOrderJsonList.length == 0" class="text-center p-5 text-muted">
                        <i class="fa fa-receipt fa-3x mb-3 opacity-25"></i>
                        <p>Your cart is empty</p>
                    </div>
                    <div class="px-3">
                        <div class="d-flex align-items-center py-3 border-bottom" ng-repeat="food in selectedFoodForOrderJsonList">
                            <img src="~/Images/FoodImg/{{food.FoodItemID}}.jpg" class="rounded-3 me-3" style="width: 50px; height: 50px; margin-right:5px; object-fit: cover;">
                            <div class="flex-grow-1">
                                <div class="fw-bold small">{{food.FoodName}}</div>
                                <div class="text-primary small fw-bold"><span style="font-size: 28px;">৳</span>&nbsp;{{(food.FoodPrice * food.Quantity).toFixed(2)}}</div>
                            </div>
                            <div class="d-flex align-items-center bg-light rounded-pill px-2">
                                <button class="btn btn-link btn-sm p-1 text-dark" ng-click="decrementQuantity(food)"><i class="fa fa-minus-circle"></i></button>
                                <span class="mx-2 small fw-bold">{{food.Quantity}}</span>
                                <button class="btn btn-link btn-sm p-1 text-dark" ng-click="incrementQuantity(food)"><i class="fa fa-plus-circle"></i></button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-white border-0 p-3">
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Total Amount</span>
                        <span class="h4 fw-bold text-success"><span style="font-size: 28px;">৳</span>&nbsp;{{totalFoodPrice}}</span>
                    </div>
                    <button class="btn btn-success w-100 py-3 rounded-3 fw-bold shadow-sm" ng-disabled="confirmOrder" ng-click="clickToSaveOrder()">
                        CONFIRM ORDER
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/ngServices/FoodItemService/foodItemService.js?reload=@DateTime.Now.Date.ToShortDateString()"></script>
    <script src="~/Scripts/ngServices/FoodOrderService/foodOrderService.js?reload=@DateTime.Now.Date.ToShortDateString()"></script>
    <script src="~/Scripts/ngControllers/FoodOrder/foodOrderController.js?reload=@DateTime.Now.Date.ToShortDateString()"></script>
    <script>
        $(document).ready(function () {
            // On clicking any menu item
            $(".menu-item").click(function (e) {
                e.preventDefault(); // Prevent the default link behavior

                // Remove 'active' class from all menu items
                $(".menu-item").removeClass("active");

                // Add 'active' class to the clicked menu item
                $(this).addClass("active");
            });
        });
    </script>
}
